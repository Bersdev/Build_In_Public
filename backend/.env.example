# Copie para backend/.env. Nunca envie o .env ao GitHub.

# development, test ou production
ENVIRONMENT=development

# Sem esta variável, o SQLite fica em %LOCALAPPDATA%\BuildInPublic (fora do OneDrive).
# Exemplo em produção: postgresql+psycopg://usuario:senha@servidor/build_in_public
# DATABASE_URL=

# Use true em produção, sempre com HTTPS.
COOKIE_SECURE=false

# Endereço do frontend, usado no link de recuperação de senha.
FRONTEND_URL=http://localhost:5173
